# Copiar a `terraform.tfvars` (git-ignorado) y completar.
#
# Aquí solo van valores NO secretos. Los cuatro tokens de API se exportan en la
# shell; ningún archivo del repositorio debe contenerlos. Ver infra/README.md.

# --- Render ---------------------------------------------------------------

# Obligatorio y sin valor por defecto. Está en la URL al abrir
# Ajustes de usuario o de equipo en https://dashboard.render.com
#   - cuenta personal: usr-...
#   - equipo:            tea-...
render_owner_id = ""

# --- Opcionales: solo si el despliegue real se aparta de los valores por defecto

# render_region  = "oregon"
# render_plan    = "free"
# render_service_name = "tienda-utb-api"
