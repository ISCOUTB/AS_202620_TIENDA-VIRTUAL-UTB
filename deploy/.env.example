# POSTGRES_DB=tienda_utb
# JWT_TTL_SEGUNDOS=3600
# SEED_ON_DEPLOY=true
# SEED_ADMIN_CORREO=admin@utb.edu.co
# SEED_ADMIN_PASSWORD=
