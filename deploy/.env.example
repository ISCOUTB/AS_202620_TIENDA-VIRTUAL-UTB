# Definir estos valores en Environment dentro de Dokploy.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Al menos 32 bytes: openssl rand -hex 32 (ADR 0016).
JWT_SECRET=

# Opcionales; el Compose utiliza estos valores por defecto.
# POSTGRES_USER=tienda_utb
# POSTGRES_DB=tienda_utb
# JWT_TTL_SEGUNDOS=3600
# SEED_ON_DEPLOY=true
# SEED_ADMIN_CORREO=admin@utb.edu.co
# SEED_ADMIN_PASSWORD=
# Un admin por tienda (<tienda> (sin guiones)), 8+ caracteres.
# SEED_TIENDAS_PASSWORD=
# Cuenta de estudiante predeterminada (rol comprador), 8+ caracteres.
# SEED_ESTUDIANTE_CORREO=estudiante@utb.edu.co
# SEED_ESTUDIANTE_PASSWORD=
