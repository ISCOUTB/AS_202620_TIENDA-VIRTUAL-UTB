# Definir estos valores en Environment dentro de Dokploy.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Al menos 32 bytes: openssl rand -hex 32 (ADR 0016).
JWT_SECRET=

# Opcionales; el Compose utiliza estos valores por defecto.
