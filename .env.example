# Variables de entorno del entorno local (Docker Compose).
# Copiar a .env (git lo ignora) y ajustar valores:
#   cp .env.example .env
#
# En Dokploy estas variables se definen en la pestaña Environment, nunca se
# versionan. Ver docs/despliegue-dokploy.md.

# Obligatoria: contraseña del PostgreSQL local. Elegir una clave propia.
POSTGRES_PASSWORD=

# Obligatoria: contraseña del rol con el que se conecta la API (ADR 0014).
APP_DB_PASSWORD=

# Obligatoria: clave de firma de los tokens, al menos 32 bytes (ADR 0016).
# Generar con: openssl rand -hex 32
JWT_SECRET=

# Opcionales: valores por defecto del entorno de desarrollo.
# POSTGRES_USER=tienda_utb
# POSTGRES_DB=tienda_utb
# SEED_ON_DEPLOY=true   # el servicio seed siembra datos demo en cada up
# JWT_TTL_SEGUNDOS=3600 # vigencia de la sesión
# Administrador general inicial; solo se crea si SEED_ON_DEPLOY=true.
# SEED_ADMIN_CORREO=admin@utb.edu.co
# SEED_ADMIN_PASSWORD=
