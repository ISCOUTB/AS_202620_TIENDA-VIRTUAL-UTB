{
  "name": "tienda-virtual-utb-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run gen:api && npm run check:tokens && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^15.5.9",
    "react": "^19.1.2",
    "react-dom": "^19.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint-config-next": "^15.5.9",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.2",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
