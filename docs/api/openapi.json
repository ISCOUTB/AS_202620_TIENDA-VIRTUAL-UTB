{
  "openapi": "3.1.0",
  "info": {
    "title": "Tienda Virtual UTB",
    "version": "0.4.0"
  },
  "paths": {
    "/identity/register": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Register",
        "description": "Crea una cuenta de comprador. El correo no distingue mayúsculas.",
        "operationId": "register_identity_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "409": {
            "description": "El correo ya está registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/identity/login": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Login",
        "description": "Autentica con correo y contraseña y entrega un token de acceso.",
        "operationId": "login_identity_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/identity/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Me",
        "description": "Perfil y roles del usuario autenticado.",
        "operationId": "me_identity_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/catalog/products": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Get Products",
        "description": "Lista los productos disponibles en el catálogo.",
        "operationId": "get_products_catalog_products_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductOut"
                  },
                  "type": "array",
                  "title": "Response Get Products Catalog Products Get"
                }
              }
            }
          }
        }
      }
    },
    "/inventory": {
      "get": {
        "tags": [
          "inventario"
        ],
        "summary": "Get Inventory",
        "description": "Lista la disponibilidad necesaria para presentar el catálogo.",
        "operationId": "get_inventory_inventory_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StockOut"
                  },
                  "type": "array",
                  "title": "Response Get Inventory Inventory Get"
                }
              }
            }
          }
        }
      }
    },
    "/inventory/{productId}": {
      "get": {
        "tags": [
          "inventario"
        ],
        "summary": "Get Stock",
        "description": "Existencias de un producto, con la fecha del último cambio.",
        "operationId": "get_stock_inventory__productId__get",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "ID del producto",
              "title": "Productid"
            },
            "description": "ID del producto"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryItemOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Producto sin existencias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "inventario"
        ],
        "summary": "Update Stock",
        "description": "Fija la cantidad absoluta (conteo físico). Queda como movimiento `ajuste`.",
        "operationId": "update_stock_inventory__productId__put",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "ID del producto",
              "title": "Productid"
            },
            "description": "ID del producto"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryItemOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "No gestiona el inventario de la tienda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Producto no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de concurrencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inventory/{productId}/adjust": {
      "post": {
        "tags": [
          "inventario"
        ],
        "summary": "Adjust Stock",
        "description": "Suma o resta unidades (reposición, merma) con un motivo obligatorio.",
        "operationId": "adjust_stock_inventory__productId__adjust_post",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "ID del producto",
              "title": "Productid"
            },
            "description": "ID del producto"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryAdjustRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryItemOut"
                }
              }
            }
          },
          "400": {
            "description": "Ajuste inválido: cero o deja el stock en negativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "No gestiona el inventario de la tienda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Producto sin existencias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de concurrencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operacion"
        ],
        "summary": "Health",
        "description": "Liveness: confirma que el proceso de la API está disponible.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "operacion"
        ],
        "summary": "Health Ready",
        "description": "Readiness: además del proceso, verifica que la base de datos responde.",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "operacion"
        ],
        "summary": "Metrics",
        "description": "Métricas HTTP del proceso, ligadas al escenario de disponibilidad.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Metrics Metrics Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOut"
      },
      "InventoryAdjustRequest": {
        "properties": {
          "delta": {
            "type": "integer",
            "title": "Delta",
            "description": "Positivo = reposición, negativo = venta o merma."
          },
          "motivo": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Motivo",
            "description": "Razón del ajuste."
          }
        },
        "type": "object",
        "required": [
          "delta",
          "motivo"
        ],
        "title": "InventoryAdjustRequest"
      },
      "InventoryItemOut": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "product_nombre": {
            "type": "string",
            "title": "Product Nombre"
          },
          "cantidad": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cantidad",
            "description": "Unidades disponibles en stock"
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time",
            "title": "Actualizado En"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "product_nombre",
          "cantidad",
          "actualizado_en"
        ],
        "title": "InventoryItemOut"
      },
      "InventoryUpdateRequest": {
        "properties": {
          "cantidad": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cantidad",
            "description": "Nueva cantidad absoluta de stock"
          },
          "motivo": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Motivo",
            "description": "Razón del cambio, para la auditoría de movimientos.",
            "default": "Conteo de existencias"
          }
        },
        "type": "object",
        "required": [
          "cantidad"
        ],
        "title": "InventoryUpdateRequest"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ProductOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion"
          },
          "precio_centavos": {
            "type": "integer",
            "title": "Precio Centavos"
          },
          "tienda": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tienda",
            "description": "Identificador (slug) de la tienda dueña del producto."
          },
          "imagen_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imagen Url",
            "description": "Ruta relativa de la imagen principal, si existe."
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "descripcion",
          "precio_centavos"
        ],
        "title": "ProductOut"
      },
      "ReadinessOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "detalle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detalle"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReadinessOut"
      },
      "RegisterRequest": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "RolAsignado": {
        "properties": {
          "codigo": {
            "type": "string",
            "enum": [
              "comprador",
              "admin_general",
              "admin_tienda",
              "responsable_inventario"
            ],
            "title": "Codigo"
          },
          "tienda_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tienda Id",
            "description": "Tienda donde vale el rol; null = todas."
          }
        },
        "type": "object",
        "required": [
          "codigo"
        ],
        "title": "RolAsignado"
      },
      "StockOut": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "existencias": {
            "type": "integer",
            "title": "Existencias"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "existencias"
        ],
        "title": "StockOut"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Vigencia del token en segundos."
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenResponse"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RolAsignado"
            },
            "type": "array",
            "title": "Roles"
          },
          "creado_en": {
            "type": "string",
            "format": "date-time",
            "title": "Creado En"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "email",
          "roles",
          "creado_en"
        ],
        "title": "UserOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
