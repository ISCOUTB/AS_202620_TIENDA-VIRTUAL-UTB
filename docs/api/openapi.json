{
  "openapi": "3.1.0",
  "info": {
    "title": "Tienda Virtual UTB",
    "version": "0.2.1"
  },
  "paths": {
    "/catalog/products": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Get Products",
        "description": "Lista los productos disponibles en el catálogo.",
        "operationId": "get_products_catalog_products_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductOut"
                  },
                  "type": "array",
                  "title": "Response Get Products Catalog Products Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operacion"
        ],
        "summary": "Health",
        "description": "Liveness: confirma que el proceso de la API está disponible.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "operacion"
        ],
        "summary": "Health Ready",
        "description": "Readiness: además del proceso, verifica que la base de datos responde.",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "operacion"
        ],
        "summary": "Metrics",
        "description": "Métricas HTTP del proceso, ligadas al escenario de disponibilidad.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Metrics Metrics Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOut"
      },
      "ProductOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion"
          },
          "precio_centavos": {
            "type": "integer",
            "title": "Precio Centavos"
          },
          "existencias": {
            "type": "integer",
            "title": "Existencias"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "descripcion",
          "precio_centavos",
          "existencias"
        ],
        "title": "ProductOut"
      },
      "ReadinessOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "detalle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detalle"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReadinessOut"
      }
    }
  }
}
