        "title": "HealthOut"
      },
      "ProductOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion"
          },
          "precio_centavos": {
            "type": "integer",
            "title": "Precio Centavos"
          },
          "existencias": {
            "type": "integer",
            "title": "Existencias"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "descripcion",
          "precio_centavos",
          "existencias"
        ],
        "title": "ProductOut"
      }
    }
